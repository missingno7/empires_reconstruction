    {
      "id": "M_6D86_6F4B",
      "kind": "MATCHING_ASM",
      "source": "asm/DECODE.ASM",
      "start": 28550,
      "end": 29123,
      "members": [
        "F_6D86",
        "PAD_006FC5",
